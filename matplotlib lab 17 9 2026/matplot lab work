import matplotlib.pyplot as pt

h = [1,2,3,4,5,6,7,8]
m = [30, 40, 50, 60, 70, 80, 90, 95]
pt.scatter(h, m, 
           s = 80, 
           marker = '^', 
           alpha = 0.3, 
           color = 'black', 
           label = 'Relationship between Hours and Marks'
          )

pt.title('Performance', fontsize = 20)
pt.xlabel('Hours')
pt.ylabel('Marks')
pt.legend()
pt.grid()

pt.show()
